# --- LLM Provider (Gateway Only) ---
# Options: local, apigee, enterprise
LLM_PROVIDER=local
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=qwen/qwen3-vl-8b
LLM_MAX_TOKENS=100000

# --- Embedding Model Configuration ---
# Model: HuggingFace name or local path
# Examples:
#   - BAAI/bge-base-en-v1.5 (default, 768d)
#   - sentence-transformers/all-MiniLM-L6-v2 (384d)
#   - /path/to/local/model (local directory)
EMBEDDING_PROVIDER=remote
EMBEDDING_API_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
# EMBEDDING_DIMENSION auto-detected via probe request; set manually to override
EMBEDDING_MAX_TOKENS=2000
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CONCURRENT=4
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

