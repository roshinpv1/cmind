# =================================================================
# CodeMind v2: Agentic Graph-Grounded Code Intelligence
# Environment Configurations
# =================================================================

# --- LLM Provider (Gateway Only) ---
# Options: local, apigee, enterprise
LLM_PROVIDER=local
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=qwen/qwen3-vl-8b
LLM_MAX_TOKENS=100000

# --- Embedding Model Configuration ---
# 1. Local (SentenceTransformers)
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# EMBEDDING_DIMENSION=768
# EMBEDDING_MAX_TOKENS=512
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# 2. Remote (OpenAI-compatible Endpoint)
# Supported by: OpenAI, Ollama, vLLM, etc.
# EMBEDDING_PROVIDER=remote
# EMBEDDING_API_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama  # Optional
# EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
# EMBEDDING_DIMENSION=768
# EMBEDDING_BATCH_SIZE=10
# EMBEDDING_MAX_CONCURRENT=4   # parallel HTTP batch calls (Remote/Apigee only)
# EMBEDDING_TIMEOUT=60         # HTTP timeout in seconds (Remote/Apigee only)

# 3. Apigee (Enterprise Gateway)
# EMBEDDING_PROVIDER=apigee
# EMBEDDING_MODEL=your-model-name
# ENTERPRISE_BASE_URL=https://apigw.example.com/path/to/api
# WF_CLIENT_ID=your-client-id
# WF_API_KEY=your-api-key
# WF_USE_CASE_ID=your-use-case-id
# EMBEDDING_DIMENSION=768
# EMBEDDING_BATCH_SIZE=16
# EMBEDDING_MAX_CONCURRENT=4
# EMBEDDING_TIMEOUT=60

# --- Enterprise Git Integration ---

# Personal Access Tokens
# GIT_ACCESS_TOKEN=your_github_token_here
# GITLAB_TOKEN=your_gitlab_token_here

# GitSaaS GitHub App credentials (for CI/CD pipelines)
# APP_INSTALLATION_ID=1057118
# GITSAAS_APP_ID=123456
# GITSAAS_PRIVATE_KEY=MIIEOWIBAAKCAQEAnqb+v4WXVXDo
# GITSAAS_INSTALLATION_ID=789012

# SSH Keys (for SSH clones)
# CODEMIND_SSH_PRIVATE_KEY=/path/to/id_rsa
# CODEMIND_SSH_PASSPHRASE=your_passphrase_here

# On-prem GitHub Enterprise tokens
# ONPREM_WFS_GIT_TOKEN=ghp_abcd
# ONPREM_GIT_TOKEN=ghp_xyz

# Enterprise SSL bypass for corporate proxies
# GITHUB_ENTERPRISE_DISABLE_SSL=false
# GITHUB_ENTERPRISE_CA_BUNDLE=/path/to/ca-bundle.crt

# Git Timeouts (in seconds)
# CODEMIND_GIT_CLONE_TIMEOUT=300
# CODEMIND_GIT_FETCH_TIMEOUT=180
# CODEMIND_GITHUB_API_TIMEOUT=120

# --- Database Backend ---
# Options: sqlite (default), mongodb
DB_BACKEND=sqlite

# Document Store (MongoDB settings when DB_BACKEND=mongodb)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=codemind

# Local Disk Storage Paths (sqlite, lance, kuzu, file caches)
# Override these to use a custom location (e.g. a shared volume in Docker/k8s).
CODEMIND_DB_PATH=data/codemind.db        
CODEMIND_LANCEDB_PATH=data/lancedb       
CODEMIND_REPOS_PATH=data/repos           
CODEMIND_PLAYBOOKS_PATH=playbooks        
CODEMIND_KUZU_PATH=data/kuzu_worker

# --- Graph Settings (Kuzu / Neo4j) ---
# For Neo4j export testing (optional)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- API and Worker Settings ---
# CODEMIND_API_URL=http://localhost:8000
# CODEMIND_TIMEOUT=120
WORKER_POLL_INTERVAL=5

# --- SSO / JWT Security ---
# Secret key used for signing web JWT tokens
JWT_SECRET_KEY=74889c1694d9b2323c6f2a7a371c6ca674889c1694d
