# =================================================================
# CodeMind v2: Agentic Graph-Grounded Code Intelligence
# =================================================================

# --- LLM Provider (Gateway Only) ---
# Options: local, apigee, enterprise
LLM_PROVIDER=local
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=openai/gpt-oss-20b
LLM_MAX_TOKENS=100000

# --- Cluster/Graph Settings ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# --- Github Access ---
GIT_ACCESS_TOKEN=your_github_token_here

# --- Embedding Model Configuration ---
# 1. Local (SentenceTransformers)
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# EMBEDDING_DIMENSION=768
# EMBEDDING_MAX_TOKENS=512
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# 2. Remote (OpenAI-compatible Endpoint)
# Automatic if EMBEDDING_API_URL is set (EMBEDDING_PROVIDER can be omitted)
# Supported by: OpenAI, Ollama, vLLM, etc.
# EMBEDDING_PROVIDER=remote
# EMBEDDING_API_URL=http://localhost:11434/v1
# EMBEDDING_API_KEY=ollama  # Optional
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768
# EMBEDDING_BATCH_SIZE=10
