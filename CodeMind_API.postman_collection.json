        {
            "name": "6. Catalogs",
            "description": "Manage repository catalogs — high-level documentation and summaries generated by playbooks.\n\nDual-store: full content in SQLite, chunked embeddings in LanceDB for semantic search.",
            "item": [
                {
                    "name": "Create Catalog Entry",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"repo_id\": \"{{repo_id}}\",\n  \"playbook_name\": \"catalog_generator\",\n  \"prompt\": \"Generate a comprehensive architectural overview\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs"
                            ]
                        },
                        "description": "Trigger a playbook to generate a catalog entry for a repository.\n\nAvailable playbooks: catalog_generator, code_analyzer"
                    }
                },
                {
                    "name": "Get Catalog Entries",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/{{repo_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "{{repo_id}}"
                            ]
                        },
                        "description": "Retrieve full catalog content for a specific repository.\n\nReturns the complete auto-generated summary stored in SQLite (not the chunked vectors)."
                    }
                },
                {
                    "name": "Search Catalogs (GET)",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/search?query=authentication&limit=5&min_score=0.8",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "search"
                            ],
                            "query": [
                                {
                                    "key": "query",
                                    "value": "authentication"
                                },
                                {
                                    "key": "limit",
                                    "value": "5"
                                },
                                {
                                    "key": "min_score",
                                    "value": "0.8"
                                }
                            ]
                        },
                        "description": "Semantic search across catalog entries using GET parameters.\n\nUses the same high-quality retrieval logic as POST search (dedupe + SQLite context enrichment)."
                    }
                },
                {
                    "name": "Search Catalogs (POST)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"authentication system\",\n  \"limit\": 5,\n  \"min_score\": 0.8\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/search",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "search"
                            ]
                        },
                        "description": "High-quality semantic search across all catalog entries (cross-repository search).\n\nUses advanced retrieval: processes multiple queries, dedupes by repository (max score), and enriches results with full SQLite context."
                    }
                },
