                            "raw": "{\n  \"goal\": \"Generate comprehensive documentation including README, API reference, and setup guide\",\n  \"repo_id\": \"{{repo_id}}\",\n  \"max_iterations\": 10,\n  \"allowed_playbooks\": [\"code_explorer\"]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/agents/autonomous",
