{
    "info": {
        "_postman_id": "codemind-api-collection",
        "name": "CodeMind API",
        "description": "CodeMind API with LangGraph Agents",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000"
        },
        {
            "key": "repo_id",
            "value": "1dd450cb2ecd63a9",
            "description": "Default repo ID for testing"
        }
    ],
    "item": [
        {
            "name": "Indexing",
            "item": [
                {
                    "name": "Index Local Path",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"repo_path\": \"/Users/username/projects/my-repo\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/index",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "index"
                            ]
                        }
                    }
                },
                {
                    "name": "Index Git URL",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"repo_url\": \"https://github.com/fastapi/fastapi.git\",\n  \"branch\": \"master\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/index",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "index"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Job Status",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/api/v1/jobs/:job_id",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "jobs",
                                ":job_id"
                            ],
                            "variable": [
                                {
                                    "key": "job_id",
                                    "value": "abc-123"
                                }
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Search",
            "item": [
                {
                    "name": "Semantic Search",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"authentication functions\",\n  \"repo_id\": \"{{repo_id}}\",\n  \"search_mode\": \"semantic\",\n  \"limit\": 10\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/search",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "search"
                            ]
                        }
                    }
                },
                {
                    "name": "Hybrid Search with Filters",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"API endpoints\",\n  \"repo_id\": \"{{repo_id}}\",\n  \"search_mode\": \"hybrid\",\n  \"filters\": {\n    \"file_type\": \".py\",\n    \"file_patterns\": [\"api\", \"routes\"]\n  },\n  \"limit\": 10\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/search",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "search"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Agents (LangGraph)",
            "item": [
                {
                    "name": "Generate README",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"agent_type\": \"doc_generator\",\n  \"repo_id\": \"{{repo_id}}\",\n  \"task\": \"generate_readme\",\n  \"config\": {\n    \"doc_type\": \"readme\",\n    \"include_examples\": true\n  }\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/agents/execute",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "agents",
                                "execute"
                            ]
                        },
                        "description": "Starts LangGraph workflow to generate README using:\n1. analyze_structure\n2. identify_components\n3. extract_features\n4. generate_documentation"
                    }
                },
                {
                    "name": "Get Agent Status",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/api/v1/agents/:job_id/status",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "agents",
                                ":job_id",
                                "status"
                            ],
                            "variable": [
                                {
                                    "key": "job_id",
                                    "value": "ee77ac09-19fe-4e3d-9249-9b1f58e1edf4"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Agent Result",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/api/v1/agents/:job_id/result",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "agents",
                                ":job_id",
                                "result"
                            ],
                            "variable": [
                                {
                                    "key": "job_id",
                                    "value": "ee77ac09-19fe-4e3d-9249-9b1f58e1edf4"
                                }
                            ]
                        },
                        "description": "Returns generated documentation and progress tracking:\n- documentation: Generated README\n- progress: [\"✓ Analyzed structure\", \"✓ Found components\", ...]\n- error: null if successful"
                    }
                }
            ]
        },
        {
            "name": "System",
            "item": [
                {
                    "name": "Health Check",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/api/v1/health",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "health"
                            ]
                        }
                    }
                },
                {
                    "name": "System Stats",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{base_url}}/api/v1/stats",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "stats"
                            ]
                        }
                    }
                }
            ]
        }
    ]
}