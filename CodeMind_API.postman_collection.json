{
    "info": {
        "name": "CodeMind API",
        "description": "Complete API collection for CodeMind — AI-powered code intelligence platform.\n\nBase URL: {{base_url}} (default: http://localhost:8000)",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8000",
            "type": "string"
        },
        {
            "key": "repo_id",
            "value": "",
            "type": "string"
        },
        {
            "key": "job_id",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Health & Debug",
            "item": [
                {
                    "name": "Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/health",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "health"
                            ]
                        },
                        "description": "Check API health, embedding model, and embedding dimensions."
                    }
                },
                {
                    "name": "Debug Routes",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/debug/routes",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "debug",
                                "routes"
                            ]
                        },
                        "description": "List all registered API routes."
                    }
                },
                {
                    "name": "System Stats",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/stats",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "stats"
                            ]
                        },
                        "description": "Get system statistics — total/pending/running/completed/failed jobs."
                    }
                }
            ]
        },
        {
            "name": "Indexing",
            "item": [
                {
                    "name": "Index Repository (Local Path)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"repo_path\": \"/path/to/local/repo\",\n  \"branch\": \"main\",\n  \"org\": \"my-org\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/index",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "index"
                            ]
                        },
                        "description": "Start indexing a local repository. Returns a job_id for tracking."
                    }
                },
                {
                    "name": "Index Repository (Git URL)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"repo_url\": \"https://github.com/owner/repo.git\",\n  \"branch\": \"main\",\n  \"org\": \"my-org\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/index",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "index"
                            ]
                        },
                        "description": "Start indexing a remote Git repository. Returns a job_id for tracking."
                    }
                },
                {
                    "name": "Get Job Status",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/jobs/{{job_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "jobs",
                                "{{job_id}}"
                            ]
                        },
                        "description": "Get the status of an indexing job."
                    }
                }
            ]
        },
        {
            "name": "Search",
            "item": [
                {
                    "name": "Semantic Search",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"authentication middleware\",\n  \"repo_id\": \"{{repo_id}}\",\n  \"limit\": 10,\n  \"search_mode\": \"hybrid\",\n  \"filters\": null,\n  \"expand_context\": true\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/search",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "search"
                            ]
                        },
                        "description": "Semantic/hybrid search across indexed code. Modes: semantic, structural, hybrid."
                    }
                },
                {
                    "name": "Graph Query",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"repo_id\": \"{{repo_id}}\",\n  \"query_type\": \"classes\",\n  \"pattern\": \"Service\",\n  \"file_type\": null,\n  \"class_name\": null,\n  \"symbol_name\": null\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/graph/query",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "graph",
                                "query"
                            ]
                        },
                        "description": "Query code structure graph. query_type: files, classes, functions, symbol."
                    }
                }
            ]
        },
        {
            "name": "Repositories",
            "item": [
                {
                    "name": "List Repositories",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/repos",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "repos"
                            ]
                        },
                        "description": "List all indexed repositories."
                    }
                },
                {
                    "name": "Get Repository Detail",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/repos/{{repo_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "repos",
                                "{{repo_id}}"
                            ]
                        },
                        "description": "Get detailed info for a single repository."
                    }
                },
                {
                    "name": "Update Repository Metadata",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"org\": \"updated-org\",\n  \"repo_url\": \"https://github.com/owner/repo\",\n  \"branch\": \"main\",\n  \"first_author\": \"john.doe\",\n  \"total_commits\": 150,\n  \"last_pr_title\": \"Fix auth bug\",\n  \"last_pr_user\": \"jane.doe\",\n  \"last_pr_merged_at\": \"2026-02-27T10:00:00Z\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/repos/{{repo_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "repos",
                                "{{repo_id}}"
                            ]
                        },
                        "description": "Update repository metadata. Only non-null fields are updated."
                    }
                }
            ]
        },
        {
            "name": "Catalogs",
            "item": [
                {
                    "name": "List Catalog Entries",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/list",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "list"
                            ]
                        },
                        "description": "List all catalog entries."
                    }
                },
                {
                    "name": "List Catalog Entries (Filtered)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/list?status=proposed",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "list"
                            ],
                            "query": [
                                {
                                    "key": "status",
                                    "value": "proposed",
                                    "description": "Filter: active, proposed, qualified"
                                }
                            ]
                        },
                        "description": "List catalog entries filtered by status (active, proposed, qualified)."
                    }
                },
                {
                    "name": "Get Catalog Entry",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/{{repo_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "{{repo_id}}"
                            ]
                        },
                        "description": "Get a single catalog entry by repo_id."
                    }
                },
                {
                    "name": "Create Catalog Entry",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"repo_id\": \"{{repo_id}}\",\n  \"playbook_name\": \"code_analyzer\",\n  \"prompt\": \"Analyze this repository and generate a catalog entry\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs"
                            ]
                        },
                        "description": "Execute a playbook on a repo and store the result as a catalog entry."
                    }
                },
                {
                    "name": "Create Proposal (from Gap)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"gap_name\": \"API Gateway Service\",\n  \"gap_description\": \"A centralized API gateway for routing, authentication, and rate limiting\",\n  \"architecture_layer\": \"Infrastructure\",\n  \"user_query\": \"We need an API gateway for our microservices\",\n  \"org\": \"platform-team\",\n  \"created_by\": \"john.doe\",\n  \"build_cost_usd\": 50000,\n  \"dev_weeks\": 8\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/propose",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "propose"
                            ]
                        },
                        "description": "Create a proposed catalog entry from a gap analysis. Auto-generates requirements via LLM."
                    }
                },
                {
                    "name": "List Proposed Entries",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/proposed",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "proposed"
                            ]
                        },
                        "description": "List all proposed catalog entries (status=proposed or qualified)."
                    }
                },
                {
                    "name": "Match Gaps to Proposed",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"gaps\": [\n    { \"name\": \"API Gateway\", \"description\": \"Centralized routing service\" },\n    { \"name\": \"Auth Service\", \"description\": \"OAuth2 authentication\" }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/match-gaps",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "match-gaps"
                            ]
                        },
                        "description": "Match gap names against existing proposed catalog entries using fuzzy matching."
                    }
                },
                {
                    "name": "Update Proposal Requirements",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"requirements\": {\n    \"functional_requirements\": [\"JWT authentication\", \"Rate limiting\"],\n    \"non_functional_requirements\": [\"<100ms latency\", \"99.9% uptime\"],\n    \"api_contracts\": [\"POST /auth/token\", \"GET /auth/validate\"],\n    \"data_model\": \"User, Token, Session tables\",\n    \"integration_points\": [\"LDAP\", \"OAuth2 providers\"],\n    \"acceptance_criteria\": [\"All tests pass\", \"Load test 1000rps\"]\n  }\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/{{repo_id}}/requirements",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "{{repo_id}}",
                                "requirements"
                            ]
                        },
                        "description": "Update requirements for a proposed catalog entry."
                    }
                },
                {
                    "name": "Contribute to Proposal",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"uid\": \"john.doe\",\n  \"org\": \"platform-team\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/{{repo_id}}/contribute",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "{{repo_id}}",
                                "contribute"
                            ]
                        },
                        "description": "Record a contributor's UID and Org against an existing proposed catalog entry."
                    }
                },
                {
                    "name": "Promote Proposal",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"git_url\": \"https://github.com/owner/repo\",\n  \"git_branch\": \"main\",\n  \"quality_score\": 8\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/{{repo_id}}/promote",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "{{repo_id}}",
                                "promote"
                            ]
                        },
                        "description": "Promote a proposed/qualified catalog entry to active status with a git URL."
                    }
                },
                {
                    "name": "Delete Catalog Entry",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/{{repo_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "{{repo_id}}"
                            ]
                        },
                        "description": "Delete a proposed or qualified catalog entry. Cannot delete active entries."
                    }
                },
                {
                    "name": "Catalog Search (GET)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/search?q=authentication&limit=5",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "search"
                            ],
                            "query": [
                                {
                                    "key": "q",
                                    "value": "authentication"
                                },
                                {
                                    "key": "limit",
                                    "value": "5"
                                }
                            ]
                        },
                        "description": "Search catalog entries by keyword (GET variant)."
                    }
                },
                {
                    "name": "Catalog Search (POST)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"query\": \"authentication service\",\n  \"repo_id\": null,\n  \"limit\": 5,\n  \"min_score\": 0.8\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/catalogs/search",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "catalogs",
                                "search"
                            ]
                        },
                        "description": "Search catalog entries semantically (POST variant with more options)."
                    }
                }
            ]
        },
        {
            "name": "Autonomous Agents",
            "item": [
                {
                    "name": "Execute Autonomous Agent",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"goal\": \"Analyze the architecture of this codebase and identify design patterns\",\n  \"repo_id\": \"{{repo_id}}\",\n  \"max_iterations\": 10,\n  \"allowed_playbooks\": null\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/agents/autonomous",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "agents",
                                "autonomous"
                            ]
                        },
                        "description": "Execute an autonomous agent with a natural language goal. Returns a job_id for tracking."
                    }
                },
                {
                    "name": "Execute Autonomous (Catalog Search)",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"goal\": \"Find reusable components for building a payment processing system\",\n  \"repo_id\": [\"repo1\", \"repo2\"],\n  \"max_iterations\": 10,\n  \"allowed_playbooks\": [\"design_solution\"]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/agents/autonomous",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "agents",
                                "autonomous"
                            ]
                        },
                        "description": "Execute autonomous agent restricted to specific playbooks (e.g., design_solution for catalog search)."
                    }
                },
                {
                    "name": "Get Agent Job Status",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/agents/autonomous/{{job_id}}/status",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "agents",
                                "autonomous",
                                "{{job_id}}",
                                "status"
                            ]
                        },
                        "description": "Get status of an autonomous agent job (pending, running, completed, failed)."
                    }
                },
                {
                    "name": "Get Agent Job Result",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/agents/autonomous/{{job_id}}/result",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "agents",
                                "autonomous",
                                "{{job_id}}",
                                "result"
                            ]
                        },
                        "description": "Get result of a completed autonomous agent job. Returns 425 if still running."
                    }
                },
                {
                    "name": "Execute Single Playbook",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"playbook_name\": \"code_analyzer\",\n  \"prompt\": \"Analyze the main entry points and API surface\",\n  \"repo_id\": \"{{repo_id}}\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/agents/playbook",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "agents",
                                "playbook"
                            ]
                        },
                        "description": "Execute a single playbook directly. Use playbook_name='auto' for LLM-based selection."
                    }
                }
            ]
        },
        {
            "name": "Git Integration",
            "item": [
                {
                    "name": "Search Git Repositories",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/git/search?keywords=fastapi,auth&endpoint=github.com&limit=20",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "git",
                                "search"
                            ],
                            "query": [
                                {
                                    "key": "keywords",
                                    "value": "fastapi,auth",
                                    "description": "Comma-separated search terms"
                                },
                                {
                                    "key": "endpoint",
                                    "value": "github.com",
                                    "description": "Git host: github.com, gitlab.com, bitbucket.org, or enterprise hostname"
                                },
                                {
                                    "key": "limit",
                                    "value": "20"
                                }
                            ]
                        },
                        "description": "Search repositories across Git platforms (GitHub, GitLab, Bitbucket, Enterprise)."
                    }
                },
                {
                    "name": "List Git Branches",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/git/branches?owner=microsoft&name=vscode&endpoint=github.com",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "git",
                                "branches"
                            ],
                            "query": [
                                {
                                    "key": "owner",
                                    "value": "microsoft"
                                },
                                {
                                    "key": "name",
                                    "value": "vscode"
                                },
                                {
                                    "key": "endpoint",
