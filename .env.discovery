# =================================================================
# Discovery Agent Configuration
# =================================================================
# This file is loaded independently from CodeMind Core's .env
# Place this file at the project root (same level as .env)

# --- CodeMind Core Connection ---
# URL where CodeMind Core API is running
CODEMIND_URL=http://localhost:8000

# --- Discovery Agent Server ---
DISCOVERY_HOST=0.0.0.0
DISCOVERY_PORT=8001

# --- Embedding Configuration ---
# Must match Core's embedding setup for consistent vector search
# Options: local, remote
EMBEDDING_PROVIDER=remote
EMBEDDING_API_URL=http://localhost:1234/v1
EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
# EMBEDDING_DIMENSION auto-detected via probe request; set manually to override
EMBEDDING_MAX_TOKENS=2000
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CONCURRENT=4
EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 

# --- Alternative: local embedding (uncomment to use) ---
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# EMBEDDING_DIMENSION=768
# EMBEDDING_MAX_TOKENS=512
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_QUERY_PREFIX=Represent this sentence for searching relevant passages: 

# --- Storage Paths ---
# Discovery Agent uses its own databases, separate from Core
DISCOVERY_SQLITE_PATH=data/discovery_agent.db
DISCOVERY_LANCEDB_PATH=data/discovery_lance

# --- Polling Configuration ---
# How frequently to poll Core for async playbook results (seconds)
DISCOVERY_POLL_INTERVAL=2.0
# Maximum time to wait for a playbook result before timeout (seconds)
DISCOVERY_POLL_TIMEOUT=300.0

# --- LLM Configuration ---
# Used for Intelligent Discovery and Build vs Reuse analysis
# Discovery Agent calls an OpenAI-compatible chat completion API
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen2.5-14b-instruct
LLM_API_KEY=not-needed
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
